/* Klang River Dashboard Styles */

* {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
}

body {
    font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Oxygen, Ubuntu, 'Helvetica Neue', Arial, sans-serif;
    background: linear-gradient(135deg, #1e3c72 0%, #2a5298 100%);
    color: #333;
    overflow-x: hidden;
}

.container {
    max-width: 1920px;
    margin: 0 auto;
    padding: 20px;
}

/* Header */
.header {
    background: linear-gradient(135deg, #0f2027, #203a43, #2c5364);
    border-radius: 12px;
    padding: 30px;
    margin-bottom: 20px;
    box-shadow: 0 8px 32px rgba(0, 0, 0, 0.3);
    display: flex;
    justify-content: space-between;
    align-items: center;
    color: white;
}

.header-content h1 {
    font-size: 2.5rem;
    font-weight: 700;
    margin-bottom: 8px;
    color: #4fc3f7;
}

.header-content .subtitle {
    font-size: 1rem;
    opacity: 0.9;
    color: #81d4fa;
}

.header-stats {
    display: flex;
    gap: 24px;
}

.stat-box {
    text-align: center;
    padding: 12px 24px;
    background: rgba(255, 255, 255, 0.1);
    border-radius: 8px;
    border: 1px solid rgba(255, 255, 255, 0.2);
}

.stat-label {
    display: block;
    font-size: 0.75rem;
    text-transform: uppercase;
    letter-spacing: 1px;
    opacity: 0.8;
    margin-bottom: 4px;
}

.stat-value {
    display: block;
    font-size: 1.75rem;
    font-weight: 700;
    color: #4fc3f7;
}

/* Main Grid Layout */
.main-grid {
    display: grid;
    grid-template-columns: 2fr 1fr;
    gap: 20px;
    margin-bottom: 20px;
}

@media (max-width: 900px) {
    .main-grid {
        grid-template-columns: 1fr;
    }
}

/* Panel Styles */
.panel {
    background: white;
    border-radius: 12px;
    box-shadow: 0 4px 16px rgba(0, 0, 0, 0.15);
    overflow: hidden;
}

.panel-stack {
    display: flex;
    flex-direction: column;
    gap: 20px;
}

.panel-header {
    background: linear-gradient(135deg, #2c5364, #203a43);
    color: white;
    padding: 20px;
    display: flex;
    justify-content: space-between;
    align-items: center;
}

.panel-header h2 {
    font-size: 1.5rem;
    font-weight: 600;
}

.panel-content {
    padding: 20px;
    max-height: 750px;
    overflow-y: auto;
}

/* Map Panel */
.map-panel .panel-content {
    padding: 0;
    position: relative;
    background: #e3f2fd;
}

#riverMap {
    display: block;
    width: 100%;
    height: auto;
    cursor: grab;
}

#riverMap:active {
    cursor: grabbing;
}

.map-controls {
    display: flex;
    gap: 8px;
}

.map-legend {
    padding: 16px 20px;
    background: #f5f5f5;
    display: flex;
    gap: 24px;
    border-top: 1px solid #ddd;
}

.legend-item {
    display: flex;
    align-items: center;
    gap: 8px;
    font-size: 0.875rem;
    cursor: pointer;
}

.legend-item input[type="checkbox"] {
    cursor: pointer;
}

.marker-dot {
    width: 12px;
    height: 12px;
    border-radius: 50%;
    display: inline-block;
}

.marker-dot.high {
    background: #f44336;
}

.marker-dot.medium {
    background: #ff9800;
}

.marker-dot.low {
    background: #4caf50;
}

/* Calculation Results */
.calc-section {
    margin-bottom: 30px;
}

.calc-section h3 {
    font-size: 1.25rem;
    color: #2c5364;
    margin-bottom: 16px;
    padding-bottom: 8px;
    border-bottom: 2px solid #4fc3f7;
}

.results-grid {
    display: grid;
    gap: 12px;
}

.result-item {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 12px;
    background: #f5f5f5;
    border-radius: 6px;
    border-left: 4px solid #4fc3f7;
}

.result-item .label {
    font-weight: 500;
    color: #555;
}

.result-item .value {
    font-weight: 700;
    font-size: 1.1rem;
    color: #2c5364;
}

.result-item .value.highlight {
    color: #f44336;
    font-size: 1.3rem;
}

.breakdown {
    margin-top: 8px;
    padding: 12px;
    background: #e3f2fd;
    border-radius: 6px;
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 8px;
}

.breakdown-item {
    font-size: 0.875rem;
    color: #666;
}

/* Discipline Cards */
.discipline-card {
    background: #f9f9f9;
    border-radius: 8px;
    padding: 16px;
    margin-bottom: 12px;
    border-left: 4px solid #4fc3f7;
}

.discipline-card h4 {
    color: #2c5364;
    margin-bottom: 12px;
    font-size: 1.1rem;
}

.discipline-details p {
    margin-bottom: 6px;
    font-size: 0.9rem;
    color: #555;
}

/* Timeline */
.timeline-task {
    background: #f5f5f5;
    border-radius: 8px;
    padding: 16px;
    margin-bottom: 12px;
    border-left: 4px solid #4fc3f7;
}

.timeline-task.priority-high {
    border-left-color: #f44336;
    background: #ffebee;
}

.timeline-task.priority-medium {
    border-left-color: #ff9800;
    background: #fff3e0;
}

.timeline-task.priority-low {
    border-left-color: #4caf50;
    background: #e8f5e9;
}

.task-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 8px;
}

.task-name {
    font-weight: 600;
    color: #2c5364;
}

.task-dates {
    font-size: 0.875rem;
    color: #666;
    font-family: monospace;
}

.task-details {
    display: flex;
    gap: 16px;
    font-size: 0.875rem;
    color: #777;
}

.task-discipline {
    font-weight: 500;
    color: #4fc3f7;
}

/* Buttons */
.btn-primary {
    background: linear-gradient(135deg, #4fc3f7, #2196f3);
    color: white;
    border: none;
    padding: 10px 20px;
    border-radius: 6px;
    font-weight: 600;
    cursor: pointer;
    transition: transform 0.2s, box-shadow 0.2s;
}

.btn-primary:hover {
    transform: translateY(-2px);
    box-shadow: 0 4px 12px rgba(33, 150, 243, 0.4);
}

.btn-small {
    background: rgba(255, 255, 255, 0.2);
    color: white;
    border: 1px solid rgba(255, 255, 255, 0.3);
    padding: 6px 12px;
    border-radius: 4px;
    font-size: 0.875rem;
    cursor: pointer;
    transition: background 0.2s;
}

.btn-small:hover {
    background: rgba(255, 255, 255, 0.3);
}

.btn-close {
    background: transparent;
    color: white;
    border: none;
    font-size: 1.5rem;
    cursor: pointer;
    padding: 0;
    width: 32px;
    height: 32px;
    display: flex;
    align-items: center;
    justify-content: center;
}

.btn-close:hover {
    background: rgba(255, 255, 255, 0.2);
    border-radius: 4px;
}

/* Export Buttons */
.export-buttons {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 12px;
}

.btn-export {
    background: white;
    border: 2px solid #4fc3f7;
    color: #2c5364;
    padding: 12px 16px;
    border-radius: 6px;
    font-weight: 600;
    cursor: pointer;
    transition: all 0.2s;
}

.btn-export:hover {
    background: #4fc3f7;
    color: white;
    transform: translateY(-2px);
}

/* Filters */
.filter-select {
    background: rgba(255, 255, 255, 0.2);
    color: white;
    border: 1px solid rgba(255, 255, 255, 0.3);
    padding: 8px 12px;
    border-radius: 4px;
    font-size: 0.875rem;
    cursor: pointer;
}

.filter-select option {
    color: #333;
    background: white;
}

/* Property Panel */
.property-panel {
    position: fixed;
    right: 20px;
    top: 50%;
    transform: translateY(-50%);
    width: 400px;
    max-width: 90vw;
    background: white;
    border-radius: 12px;
    box-shadow: 0 8px 32px rgba(0, 0, 0, 0.3);
    z-index: 1000;
    transition: transform 0.3s, opacity 0.3s;
}

.property-panel.hidden {
    transform: translateY(-50%) translateX(500px);
    opacity: 0;
    pointer-events: none;
}

.property-header {
    background: linear-gradient(135deg, #2c5364, #203a43);
    color: white;
    padding: 20px;
    display: flex;
    justify-content: space-between;
    align-items: center;
    border-radius: 12px 12px 0 0;
}

.property-header h3 {
    font-size: 1.25rem;
}

.property-content {
    padding: 20px;
    max-height: 60vh;
    overflow-y: auto;
}

/* Scrollbar Styling */
.panel-content::-webkit-scrollbar,
.property-content::-webkit-scrollbar {
    width: 8px;
}

.panel-content::-webkit-scrollbar-track,
.property-content::-webkit-scrollbar-track {
    background: #f1f1f1;
}

.panel-content::-webkit-scrollbar-thumb,
.property-content::-webkit-scrollbar-thumb {
    background: #4fc3f7;
    border-radius: 4px;
}

.panel-content::-webkit-scrollbar-thumb:hover,
.property-content::-webkit-scrollbar-thumb:hover {
    background: #2196f3;
}

/* Lock Button */
.btn-lock {
    position: absolute;
    bottom: 10px;
    left: 10px;
    background: rgba(44, 83, 100, 0.9);
    color: white;
    border: 1px solid rgba(255, 255, 255, 0.3);
    padding: 8px 12px;
    border-radius: 6px;
    font-size: 1.2rem;
    cursor: pointer;
    transition: all 0.2s;
    z-index: 100;
    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.2);
}

.btn-lock:hover {
    background: rgba(44, 83, 100, 1);
    transform: translateY(-1px);
    box-shadow: 0 3px 10px rgba(0, 0, 0, 0.3);
}

/* Responsive */
@media (max-width: 768px) {
    .header {
        flex-direction: column;
        text-align: center;
    }

    .header-stats {
        margin-top: 20px;
        flex-wrap: wrap;
        justify-content: center;
    }

    .export-buttons {
        grid-template-columns: 1fr;
    }

    .breakdown {
        grid-template-columns: 1fr;
    }

    .property-panel {
        width: 90vw;
        left: 5vw;
        right: auto;
    }
}
